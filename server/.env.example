# Runtime mode: development locally, production on the deployed backend.
NODE_ENV=development
# HTTP listening port; hosting platforms may override this.
PORT=5000
# Transaction-capable MongoDB connection URI; supply your own replica-set/Atlas URI.
MONGO_URI=mongodb://localhost:27017/ownsquare?replicaSet=rs0
# Access-JWT signing secret; generate locally and never commit the value.
JWT_SECRET=
# Access-token lifetime under the proposed P0 contract.
JWT_EXPIRES_IN=15m
# Exact allowed frontend origin, also used for password-reset links.
CLIENT_URL=http://localhost:5173
# Cloudinary account name; required for property/KYC uploads.
CLOUDINARY_CLOUD_NAME=
# Cloudinary server API key; do not expose in client configuration.
CLOUDINARY_API_KEY=
# Cloudinary server API secret; keep server-side only.
CLOUDINARY_API_SECRET=
# Payment adapter: mock or razorpay; only academic/test payments are allowed.
PAYMENT_PROVIDER=mock
# Secret for server-signed expiring mock orders; required for mock adapter.
MOCK_PAYMENT_SECRET=
# Razorpay test-mode public key ID; required only for razorpay adapter.
RAZORPAY_KEY_ID=
# Razorpay test-mode secret; required only for razorpay adapter.
RAZORPAY_KEY_SECRET=
# Initial singleton platform fee percentage; seed only, not a runtime override.
PLATFORM_FEE_PCT=2
# Initial singleton broker commission percentage; seed only.
BROKER_COMMISSION_PCT=1
# Initial singleton maximum investor ownership percentage; seed only.
MAX_OWNERSHIP_PCT=49
# Enable P1 KYC submissions/review and the server investment gate.
KYC_ENABLED=true
# Enable P1 withdrawal reservations and simulated admin processing.
WITHDRAWALS_ENABLED=true
# Enable P1 investor/broker enquiry threads.
ENQUIRIES_ENABLED=true
# Enable P1 in-app event persistence and notification endpoints.
NOTIFICATIONS_ENABLED=true
# Enable P1 email-based password reset; requires valid SMTP configuration.
PASSWORD_RESET_ENABLED=false
# Enable P1 cumulative investor ownership-cap enforcement.
OWNERSHIP_CAP_ENABLED=true
# SMTP host for password-reset email; required when password reset is enabled.
SMTP_HOST=
# SMTP port; normally 587 for STARTTLS or 465 for implicit TLS.
SMTP_PORT=587
# Use implicit SMTP TLS; normally true for port 465 and false for 587.
SMTP_SECURE=false
# SMTP account username; required by authenticated mail provider.
SMTP_USER=
# SMTP account password/application credential; never commit.
SMTP_PASS=
# Sender email address configured and verified with the mail provider.
MAIL_FROM=
# Operator-supplied demo admin password; required by seed, never logged.
# Strong local demo value only, never a real account password. Must satisfy the
# password policy: 8+ characters with a number and a symbol. Existing users keep
# their current password when the seed is re-run.
# The value below reproduces the credentials table in README.md.
SEED_ADMIN_PASSWORD=Admin@123
# Operator-supplied demo broker password (rohit@demo.com, other-broker@demo.com).
SEED_BROKER_PASSWORD=Broker@123
# Operator-supplied demo investor password (aman/priya/karan/isha/neha @demo.com).
SEED_INVESTOR_PASSWORD=Invest@123
